// Import the Express framework
import express from 'express';

// Import the recipe controller which contains the logic for each route
import * as recipeController from '../controllers/recipeController.js';

// Create a new router instance
const router = express.Router();

// Route to create a new recipe (POST /api/recipes)
router.post('/', recipeController.createRecipe);

// Route to get all recipes (GET /api/recipes)
router.get('/', recipeController.getAllRecipes);

// Route to get a single recipe by ID (GET /api/recipes/:id)
router.get('/:id', recipeController.getRecipeById);

// Route to update a recipe by ID (PUT /api/recipes/:id)
router.put('/:id', recipeController.updateRecipe);

// Route to delete a recipe by ID (DELETE /api/recipes/:id)
router.delete('/:id', recipeController.deleteRecipe);

// Export the router to be used in app.js
export default router;

