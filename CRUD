// Import mongoose for MongoDB object modeling
import mongoose from 'mongoose';

// Define the schema for a Recipe document
const recipeSchema = new mongoose.Schema({
  // Title of the recipe (required string)
  title: {
    type: String,
    required: true,
    trim: true // Remove whitespace from both ends
  },
  // List of ingredients (required array of strings)
  ingredients: {
    type: [String],
    required: true
  },
  // Cooking instructions (required string)
  instructions: {
    type: String,
    required: true
  },
  // Date when the recipe was created (defaults to now)
  createdAt: {
    type: Date,
    default: Date.now
  }
});

// Use environment variable for collection name if provided, else default to 'Recipe'
const collectionName = process.env.RECIPE_COLLECTION_NAME ?? 'Recipe';

// Export the Recipe model using the schema and the collection name.
// This allows the collection name to be set via the RECIPE_COLLECTION_NAME environment variable,
// making it flexible for different environments or naming conventions.
export default mongoose.model(collectionName, recipeSchema);

