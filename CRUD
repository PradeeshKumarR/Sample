// Import the Recipe model
import Recipe from "../models/Recipe.js";

// Import mongoose for ObjectId validation
import mongoose from "mongoose";

// Controller to create a new recipe
export const createRecipe = async (req, res) => {
  try {
    // Destructure fields from request body
    const { title, ingredients, instructions } = req.body;
    // Validate required fields
    if (!title || !ingredients || !instructions) {
      return res
        .status(400)
        .json({
          error: "All fields (title, ingredients, instructions) are required.",
        });
    }
    // Validate ingredients is a non-empty array of strings
    if (
      !Array.isArray(ingredients) ||
      ingredients.length === 0 ||
      !ingredients.every((i) => typeof i === "string")
    ) {
      return res
        .status(400)
        .json({ error: "Ingredients must be a non-empty array of strings." });
    }
    // Create a new Recipe document
    const recipe = new Recipe({ title, ingredients, instructions });
    // Save the recipe to the database
    await recipe.save();
    // Respond with the created recipe
    res.status(201).json(recipe);
  } catch (err) {
    // Handle server or validation errors
    res.status(500).json({ error: err.message || "Server error." });
  }
};

// Controller to get all recipes
export const getAllRecipes = async (req, res) => {
  try {
    // Find all recipes in the database
    const recipes = await Recipe.find();
    // Respond with the list of recipes
    res.json(recipes);
  } catch (err) {
    // Handle server errors
    res.status(500).json({ error: err.message || "Server error." });
  }
};

// Controller to get a single recipe by its ID
export const getRecipeById = async (req, res) => {
  try {
    // Extract the recipe ID from the request parameters
    const { id } = req.params;
    // Validate the ID is a valid MongoDB ObjectId
    if (!mongoose.Types.ObjectId.isValid(id)) {
      return res.status(400).json({ error: "Invalid recipe ID." });
    }
    // Find the recipe by ID
    const recipe = await Recipe.findById(id);
    // If not found, return 404
    if (!recipe) return res.status(404).json({ error: "Recipe not found." });
    // Respond with the recipe
    res.json(recipe);
  } catch (err) {
    // Handle server errors
    res.status(500).json({ error: err.message || "Server error." });
  }
};

// Controller to update a recipe by its ID
export const updateRecipe = async (req, res) => {
  try {
    // Extract the recipe ID from the request parameters
    const { id } = req.params;
    // Destructure fields from request body
    const { title, ingredients, instructions } = req.body;
    // Validate the ID is a valid MongoDB ObjectId
    if (!mongoose.Types.ObjectId.isValid(id)) {
      return res.status(400).json({ error: "Invalid recipe ID." });
    }
    // Validate required fields
    if (!title || !ingredients || !instructions) {
      return res
        .status(400)
        .json({
          error: "All fields (title, ingredients, instructions) are required.",
        });
    }
    // Validate ingredients is a non-empty array of strings
    if (
      !Array.isArray(ingredients) ||
      ingredients.length === 0 ||
      !ingredients.every((i) => typeof i === "string")
    ) {
      return res
        .status(400)
        .json({ error: "Ingredients must be a non-empty array of strings." });
    }
    // Find the recipe by ID and update it
    const recipe = await Recipe.findByIdAndUpdate(
      id,
      { title, ingredients, instructions },
      { new: true, runValidators: true }, // Return the updated document and run schema validators
    );
    // If not found, return 404
    if (!recipe) return res.status(404).json({ error: "Recipe not found." });
    // Respond with the updated recipe
    res.json(recipe);
  } catch (err) {
    // Handle server errors
    res.status(500).json({ error: err.message || "Server error." });
  }
};

// Controller to delete a recipe by its ID
export const deleteRecipe = async (req, res) => {
  try {
    // Extract the recipe ID from the request parameters
    const { id } = req.params;
    // Validate the ID is a valid MongoDB ObjectId
    if (!mongoose.Types.ObjectId.isValid(id)) {
      return res.status(400).json({ error: "Invalid recipe ID." });
    }
    // Find the recipe by ID and delete it
    const recipe = await Recipe.findByIdAndDelete(id);
    // If not found, return 404
    if (!recipe) return res.status(404).json({ error: "Recipe not found." });
    // Respond with a success message
    res.json({ message: "Recipe deleted." });
  } catch (err) {
    // Handle server errors
    res.status(500).json({ error: err.message || "Server error." });
  }
};

